# Copia a .env e introduce tus valores. No compartas .env ni lo incluyas en el repositorio.
EQUIPO=MI_EQUIPO
TOKEN=REEMPLAZAR_TOKEN_DEL_EQUIPO
SERVIDOR=ws://IP_DEL_SERVIDOR:8000
OCI_GENAI_REGION=us-chicago-1
OCI_GENAI_MODEL=openai.gpt-oss-20b
OCI_GENAI_API_KEY=REEMPLAZAR_API_KEY_DE_OCI_GENERATIVE_AI
# Opcional: exporta un objeto JSON completo en DIRECTOR_FICHA_JSON antes de iniciar el Director.
# DIRECTOR_FICHA_JSON={"ingeniero":"Mi ingeniero","piloto":"Mi piloto","numero":27,"estilo":"calculador","riesgo":3,"relacion":"cuestiona","regla_de_oro":"Cuidar las llantas","frase_radio":"Vamos equipo"}
